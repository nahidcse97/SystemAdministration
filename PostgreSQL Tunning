# CONNECTIONS & AUTHENTICATION
max_connections = 1500
listen_addresses = '*'

# MEMORY SETTINGS
shared_buffers = 48GB  # Increased for read-heavy workload
work_mem = 128MB  # Increased for complex queries
maintenance_work_mem = 4GB
effective_cache_size = 96GB

# WRITE-AHEAD LOG (WAL) SETTINGS
wal_buffers = 128MB
checkpoint_completion_target = 0.9
min_wal_size = 2GB
max_wal_size = 8GB

# QUERY OPTIMIZATION
effective_io_concurrency = 4  # Reduced for non-async I/O
random_page_cost = 1.0
default_statistics_target = 200

# PARALLEL QUERY TUNING
max_worker_processes = 8
max_parallel_workers = 8
max_parallel_workers_per_gather = 8  # Increased for parallelism
max_parallel_maintenance_workers = 4

# LOGGING SETTINGS
log_statement = 'mod'
log_min_duration_statement = 100  # Lowered to capture more slow queries
log_lock_waits = on

# TIMEOUT SETTINGS
idle_in_transaction_session_timeout = 60000
#statement_timeout = 60000

# AUTOVACUUM SETTINGS
autovacuum_vacuum_threshold = 50
autovacuum_analyze_threshold = 50
autovacuum_vacuum_cost_limit = 4000
autovacuum_vacuum_scale_factor = 0.01  # More aggressive vacuuming
autovacuum_analyze_scale_factor = 0.01

lc_messages = 'en_US.UTF-8'                     # locale for system error message
                                        # strings
lc_monetary = 'en_US.UTF-8'                     # locale for monetary formatting
lc_numeric = 'en_US.UTF-8'                      # locale for number formatting
lc_time = 'en_US.UTF-8'                         # locale for time formatting
datestyle = 'iso, mdy'
log_timezone = 'Asia/Dhaka'
log_line_prefix = '%m [%p] '
timezone = 'Asia/Dhaka'

default_text_search_config = 'pg_catalog.english'
shared_preload_libraries = 'pg_stat_statements' # (change requires restart)


pg_stat_statements.track = all
pg_stat_statements.max = 10000
pg_stat_statements.save = on

include '/var/lib/pgsql/15/data/custom_postgresql.conf'
